{
  "name": "agent-skills",
  "version": "0.1.0",
  "description": "Portable Agent Skills for Claude Code, GitHub Copilot, and OpenAI Codex",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-skills.mjs && node scripts/continuous-improvement.mjs validate-policy && node scripts/validate-evaluations.mjs",
    "validate:json": "node scripts/validate-skills.mjs --format json",
    "validate:portable": "node scripts/validate-skills.mjs --profile portable",
    "registry": "node scripts/generate-registry.mjs",
    "registry:check": "node scripts/generate-registry.mjs --check",
    "eval": "node scripts/run-evaluations.mjs",
    "eval:validate": "node scripts/validate-evaluations.mjs",
    "eval:smoke": "node scripts/run-evaluations.mjs --suite evals/evals.json --adapter node --adapter-arg tests/fixtures/evaluation-adapter.mjs --out tmp/evaluations/verification-before-completion.json",
    "routing": "node scripts/run-routing-evaluations.mjs",
    "routing:smoke": "node scripts/run-routing-evaluations.mjs --suite evals/routing.json --adapter node --adapter-arg tests/fixtures/routing-adapter.mjs --out tmp/evaluations/routing.json",
    "contributions:validate": "node scripts/validate-contributions.mjs",
    "improvement:validate": "node scripts/continuous-improvement.mjs validate-policy",
    "improvement:preflight": "node scripts/continuous-improvement.mjs preflight",
    "improvement:verify": "node scripts/continuous-improvement.mjs verify",
    "install:agents": "node scripts/manage-skills.mjs install",
    "check:agents": "node scripts/manage-skills.mjs check",
    "uninstall:agents": "node scripts/manage-skills.mjs uninstall",
    "list": "node scripts/manage-skills.mjs list",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "github-copilot",
    "openai-codex",
    "agents-md"
  ],
  "author": "Cody Sims",
  "license": "MIT"
}
