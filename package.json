{
  "name": "agent-skills",
  "version": "0.1.0",
  "description": "Portable Agent Skills for Claude Code, GitHub Copilot, and OpenAI Codex",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node scripts/validate-skills.mjs",
    "validate:json": "node scripts/validate-skills.mjs --format json",
    "validate:portable": "node scripts/validate-skills.mjs --profile portable",
    "registry": "node scripts/generate-registry.mjs",
    "registry:check": "node scripts/generate-registry.mjs --check",
    "install:agents": "node scripts/manage-skills.mjs install",
    "check:agents": "node scripts/manage-skills.mjs check",
    "uninstall:agents": "node scripts/manage-skills.mjs uninstall",
    "list": "node scripts/manage-skills.mjs list",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "github-copilot",
    "openai-codex",
    "agents-md"
  ],
  "author": "Cody Sims",
  "license": "MIT"
}
