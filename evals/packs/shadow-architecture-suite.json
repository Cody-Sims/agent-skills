    { "id": "shadow-c01", "split": "training", "kind": "positive", "prompt": "Run a bounded read-only Shadow scan of the current service boundary and produce evidence-linked candidate observations without creating decisions.", "expected": ["shadow-observe"], "excluded": ["shadow-dream", "shadow-architecture", "shadow-drift"], "handoff": null },
