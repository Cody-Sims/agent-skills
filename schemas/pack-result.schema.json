{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/pack-result.schema.json",
  "title": "Agent Skills Pack Composition Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "registry", "sourceCommit", "provenance", "pack", "adapter", "evidence", "generatedAt", "thresholds", "context", "cases", "confusion", "handoffCoverage", "summary", "status", "reason"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path", "bytes", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/version" },
        "path": { "type": "string", "minLength": 1, "maxLength": 300 },
        "bytes": { "$ref": "#/$defs/bytes" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "bytes", "sha256"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 5 },
        "bytes": { "$ref": "#/$defs/bytes" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "sourceCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "valid", "allowAncestor"],
      "properties": {
        "mode": { "type": "string", "enum": ["structural", "provenance"] },
        "valid": { "type": "boolean" },
        "allowAncestor": { "type": "boolean" }
      }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "members", "handoffs", "definitionSha256", "memberTreeSha256"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "version": { "$ref": "#/$defs/version" },
        "members": { "type": "array", "minItems": 2, "maxItems": 32, "items": { "$ref": "#/$defs/member" } },
        "handoffs": { "type": "array", "minItems": 1, "maxItems": 31, "items": { "$ref": "#/$defs/handoff" } },
        "definitionSha256": { "$ref": "#/$defs/hash" },
        "memberTreeSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "adapter": { "$ref": "#/$defs/adapter" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "vendorHostExecuted", "promotionEligible"],
      "properties": {
        "kind": { "type": "string", "enum": ["fixture", "host"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "vendorHostExecuted": { "type": "boolean" },
        "promotionEligible": { "type": "boolean" }
      }
    },
    "generatedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
    "thresholds": { "type": "null" },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memberCount", "discoveryMetadataBytes", "instructionBytes", "resourceBytes", "adapterInputTokens"],
      "properties": {
        "memberCount": { "type": "integer", "minimum": 2, "maximum": 32 },
        "discoveryMetadataBytes": { "$ref": "#/$defs/bytes" },
        "instructionBytes": { "$ref": "#/$defs/bytes" },
        "resourceBytes": { "$ref": "#/$defs/bytes" },
        "adapterInputTokens": { "$ref": "#/$defs/count" }
      }
    },
    "cases": { "type": "array", "minItems": 4, "maxItems": 256, "items": { "$ref": "#/$defs/caseResult" } },
    "confusion": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "object",
        "maxProperties": 32,
        "additionalProperties": { "$ref": "#/$defs/count" }
      }
    },
    "handoffCoverage": { "type": "array", "minItems": 1, "maxItems": 31, "items": { "$ref": "#/$defs/coverage" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "training", "validation"],
      "properties": {
        "overall": { "$ref": "#/$defs/metrics" },
        "training": { "$ref": "#/$defs/metrics" },
        "validation": { "$ref": "#/$defs/metrics" }
      }
    },
    "status": { "type": "string", "enum": ["pass", "fail", "skip"] },
    "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "maxLength": 32, "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "$ref": "#/$defs/name" }, "version": { "$ref": "#/$defs/version" } }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": { "from": { "$ref": "#/$defs/name" }, "to": { "$ref": "#/$defs/name" } }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "entrypointSha256", "policySha256", "launchPolicySha256", "launchSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "type": "string", "enum": ["fixture", "host"] },
        "entrypointSha256": { "$ref": "#/$defs/hash" },
        "policySha256": { "$ref": "#/$defs/hash" },
        "launchPolicySha256": { "$ref": "#/$defs/hash" },
        "launchSha256": { "$ref": "#/$defs/hash" }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "total"],
      "properties": {
        "input": { "$ref": "#/$defs/count" },
        "output": { "$ref": "#/$defs/count" },
        "total": { "$ref": "#/$defs/count" }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial", "selectedSkills", "truePositives", "falsePositives", "falseNegatives", "collision", "correct", "durationMs", "tokens"],
      "properties": {
        "trial": { "type": "integer", "minimum": 1, "maximum": 20 },
        "selectedSkills": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/name" } },
        "truePositives": { "$ref": "#/$defs/count" },
        "falsePositives": { "$ref": "#/$defs/count" },
        "falseNegatives": { "$ref": "#/$defs/count" },
        "collision": { "type": "boolean" },
        "correct": { "type": "boolean" },
        "durationMs": { "type": "number", "minimum": 0, "maximum": 600000 },
        "tokens": { "$ref": "#/$defs/tokens" }
      }
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "split", "kind", "promptSha256", "expected", "excluded", "handoff", "activationRate", "trials"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "split": { "type": "string", "enum": ["training", "validation"] },
        "kind": { "type": "string", "enum": ["positive", "near-miss", "negative"] },
        "promptSha256": { "$ref": "#/$defs/hash" },
        "expected": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/name" } },
        "excluded": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/name" } },
        "handoff": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "$ref": "#/$defs/name" },
            "to": { "$ref": "#/$defs/name" }
          }
        },
        "activationRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "trials": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/trial" } }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truePositives", "falsePositives", "falseNegatives", "collisions", "trials", "durationMs", "tokens", "precision", "recall", "collisionRate"],
      "properties": {
        "truePositives": { "$ref": "#/$defs/count" },
        "falsePositives": { "$ref": "#/$defs/count" },
        "falseNegatives": { "$ref": "#/$defs/count" },
        "collisions": { "$ref": "#/$defs/count" },
        "trials": { "$ref": "#/$defs/count" },
        "durationMs": { "type": "number", "minimum": 0, "maximum": 1000000000 },
        "tokens": { "$ref": "#/$defs/tokens" },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "collisionRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "positiveCases", "nearMissCases", "covered"],
      "properties": {
        "from": { "$ref": "#/$defs/name" },
        "to": { "$ref": "#/$defs/name" },
        "positiveCases": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/name" } },
        "nearMissCases": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/name" } },
        "covered": { "type": "boolean" }
      }
    }
  }
}
