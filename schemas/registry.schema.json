{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/registry.schema.json",
  "title": "Agent Skills Registry",
  "description": "Machine-readable catalog generated from skills/*/SKILL.md by scripts/generate-registry.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills", "removed"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 4
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "path", "skillFile", "sha256", "resources", "maturity", "discovery", "lifecycle"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": ["string", "null"],
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "license": {
            "type": ["string", "null"]
          },
          "tier": {
            "type": ["string", "null"],
            "enum": ["core", "extended", "experimental", null]
          },
          "maturity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "lastEvaluatedAt", "evidence"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["unverified", "verified", "regressed"]
              },
              "lastEvaluatedAt": {
                "type": ["string", "null"],
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "reference", "sha256", "recordedAt"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "structural-validation",
                        "behavior-evaluation",
                        "routing-evaluation",
                        "runtime-smoke-test",
                        "maintainer-approval",
                        "regression-report"
                      ]
                    },
                    "reference": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "recordedAt": {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    }
                  }
                }
              }
            }
          },
          "discovery": {
            "$ref": "#/properties/skills/items/$defs/discovery"
          },
          "lifecycle": {
            "$ref": "#/properties/skills/items/$defs/lifecycle"
          },
          "path": {
            "type": "string",
            "pattern": "^skills/[a-z0-9-]+$"
          },
          "skillFile": {
            "type": "string",
            "pattern": "^skills/[a-z0-9-]+/SKILL\\.md$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "$defs": {
          "typedArtifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "description"],
            "properties": {
              "type": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "description": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runtime", "status", "notes"],
            "properties": {
              "runtime": {
                "type": "string",
                "enum": ["openai-codex", "claude-code", "github-copilot"]
              },
              "status": {
                "type": "string",
                "enum": ["compatible", "conditional", "unsupported", "untested"]
              },
              "notes": { "type": ["string", "null"], "maxLength": 200 }
            }
          },
          "discovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "tags",
              "inputs",
              "outputs",
              "risk",
              "runtimeCompatibility",
              "relatedSkills",
              "conflictingSkills",
              "examplePrompts"
            ],
            "properties": {
              "category": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
              },
              "inputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "$ref": "#/properties/skills/items/$defs/typedArtifact" }
              },
              "outputs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "$ref": "#/properties/skills/items/$defs/typedArtifact" }
              },
              "risk": {
                "type": "object",
                "additionalProperties": false,
                "required": ["level", "factors"],
                "properties": {
                  "level": { "type": "string", "enum": ["low", "medium", "high"] },
                  "factors": {
                    "type": "array",
                    "maxItems": 8,
                    "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
                  }
                }
              },
              "runtimeCompatibility": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": { "$ref": "#/properties/skills/items/$defs/runtime" }
              },
              "relatedSkills": {
                "type": "array",
                "maxItems": 12,
                "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
              },
              "conflictingSkills": {
                "type": "array",
                "maxItems": 12,
                "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
              },
              "examplePrompts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          },
          "origin": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "repository", "ref", "commit"],
              "properties": {
                "type": { "type": "string", "enum": ["first-party", "external"] },
                "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:\\.git)?/?$" },
                "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
              }
          },
          "lifecycle": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "license", "lastReviewedAt", "origin"],
              "properties": {
                "status": { "type": "string", "enum": ["active", "deprecated", "superseded"] },
                "license": { "type": "string", "minLength": 1 },
                "lastReviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "reviewDueAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "replacement": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "origin": { "$ref": "#/properties/skills/items/$defs/origin" }
              }
          },
          "removedLifecycle": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "license", "lastReviewedAt", "origin"],
              "properties": {
                "status": { "type": "string", "const": "removed" },
                "license": { "type": "string", "minLength": 1 },
                "lastReviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "reviewDueAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "replacement": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "origin": { "$ref": "#/properties/skills/items/$defs/origin" }
              }
          }
        }
      }
    },
    "removed": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/properties/skills/items/$defs/removedLifecycle"
      }
    }
  }
}
