{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/routing-result.schema.json",
  "title": "Agent Skill Routing Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suite", "generatedAt", "thresholds", "cases", "confusion", "summary"],
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } } },
      "then": { "required": ["suiteSha256", "adapter"] }
    }
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1, 2] },
    "suite": { "type": "string", "minLength": 1 },
    "suiteSha256": { "$ref": "#/$defs/hash" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "adapter": { "$ref": "#/$defs/adapter" },
    "thresholds": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["policySha256", "suiteSha256", "sourceResultSha256", "measuredAt", "trials", "adapter", "measured", "limits", "observed", "passed"],
      "properties": {
        "policySha256": { "$ref": "#/$defs/hash" },
        "suiteSha256": { "$ref": "#/$defs/hash" },
        "sourceResultSha256": { "$ref": "#/$defs/hash" },
        "measuredAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "trials": { "type": "integer", "minimum": 1, "maximum": 100 },
        "adapter": { "$ref": "#/$defs/adapter" },
        "measured": { "$ref": "#/$defs/measured" },
        "limits": { "$ref": "#/$defs/limits" },
        "observed": { "$ref": "#/$defs/measured" },
        "passed": { "type": "boolean" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "split", "promptSha256", "expected", "excluded", "activationRate", "trials"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "split": { "type": "string", "enum": ["training", "validation"] },
          "promptSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "expected": { "type": "array", "items": { "type": "string" } },
          "excluded": { "type": "array", "items": { "type": "string" } },
          "activationRate": { "type": "number", "minimum": 0, "maximum": 1 },
          "trials": { "type": "array", "items": { "$ref": "#/$defs/trial" } }
        }
      }
    },
    "confusion": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "training", "validation"],
      "properties": {
        "overall": { "$ref": "#/$defs/metrics" },
        "training": { "$ref": "#/$defs/metrics" },
        "validation": { "$ref": "#/$defs/metrics" }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationRecall", "overallPrecision", "overallCollisionRate"],
      "properties": {
        "validationRecall": { "$ref": "#/$defs/rate" },
        "overallPrecision": { "$ref": "#/$defs/rate" },
        "overallCollisionRate": { "$ref": "#/$defs/rate" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumValidationRecall", "minimumOverallPrecision", "maximumOverallCollisionRate"],
      "properties": {
        "minimumValidationRecall": { "$ref": "#/$defs/rate" },
        "minimumOverallPrecision": { "$ref": "#/$defs/rate" },
        "maximumOverallCollisionRate": { "$ref": "#/$defs/rate" }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "total"],
      "properties": {
        "input": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "output": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "total": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial", "selectedSkills", "truePositives", "falsePositives", "falseNegatives", "collision", "durationMs", "tokens"],
      "properties": {
        "trial": { "type": "integer", "minimum": 1 },
        "selectedSkills": { "type": "array", "items": { "type": "string" } },
        "truePositives": { "type": "integer", "minimum": 0 },
        "falsePositives": { "type": "integer", "minimum": 0 },
        "falseNegatives": { "type": "integer", "minimum": 0 },
        "collision": { "type": "boolean" },
        "durationMs": { "type": "number", "minimum": 0 },
        "tokens": { "$ref": "#/$defs/tokens" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truePositives", "falsePositives", "falseNegatives", "collisions", "trials", "durationMs", "tokens", "precision", "recall", "collisionRate"],
      "properties": {
        "truePositives": { "type": "integer", "minimum": 0 },
        "falsePositives": { "type": "integer", "minimum": 0 },
        "falseNegatives": { "type": "integer", "minimum": 0 },
        "collisions": { "type": "integer", "minimum": 0 },
        "trials": { "type": "integer", "minimum": 0 },
        "durationMs": { "type": "number", "minimum": 0 },
        "tokens": { "$ref": "#/$defs/tokens" },
        "precision": { "type": "number", "minimum": 0, "maximum": 1 },
        "recall": { "type": "number", "minimum": 0, "maximum": 1 },
        "collisionRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}