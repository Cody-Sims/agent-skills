{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/routing-suite.schema.json",
  "title": "Agent Skill Routing Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "trials", "cases"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "trials": { "type": "integer", "minimum": 1, "maximum": 100 },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "split", "prompt", "expected", "excluded"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "split": { "type": "string", "enum": ["training", "validation"] },
          "prompt": { "type": "string", "minLength": 1 },
          "expected": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } },
          "excluded": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" } }
        }
      }
    }
  }
}