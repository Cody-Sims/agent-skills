{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/eval-suite.schema.json",
  "title": "Agent Skill Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "skill", "cases"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt", "assertions", "humanReview"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "prompt": { "type": "string", "minLength": 1 },
          "fixture": { "type": ["string", "null"] },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "value"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "type": { "type": "string", "enum": ["contains", "notContains", "regex"] },
                "value": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "flags": { "type": "string", "pattern": "^[dgimsuvy]*$" }
              }
            }
          },
          "humanReview": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "question"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                "question": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}