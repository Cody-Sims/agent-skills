{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/maturity-evidence.schema.json",
  "title": "Agent Skills Maturity Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skills"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "lastEvaluatedAt", "evidence"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["unverified", "verified", "regressed"]
          },
          "lastEvaluatedAt": {
            "type": ["string", "null"],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "reference", "sha256", "recordedAt"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "structural-validation",
                    "behavior-evaluation",
                    "routing-evaluation",
                    "runtime-smoke-test",
                    "maintainer-approval",
                    "regression-report"
                  ]
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "recordedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
