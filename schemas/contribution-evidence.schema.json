{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/contribution-evidence.schema.json",
  "title": "Agent Skill Contribution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "skill", "expertiseSources", "comparison", "exception"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "expertiseSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference", "summary"],
        "properties": {
          "type": { "type": "string", "enum": ["task-transcript", "incident-report", "runbook", "review-history", "specification", "other"] },
          "reference": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "comparison": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["baseline", "artifact", "suite", "baselinePassRate", "candidatePassRate"],
      "properties": {
        "baseline": { "type": "string", "enum": ["no-skill", "previous-release"] },
        "artifact": { "type": "string", "minLength": 1 },
        "suite": { "type": "string", "minLength": 1 },
        "baselinePassRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "candidatePassRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "exception": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "rationale"],
      "properties": {
        "type": { "type": "string", "enum": ["safety", "compliance"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}