{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/improvement-item.schema.json",
  "title": "Continuous Improvement Item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "objective",
    "status",
    "evidence",
    "expectedBenefit",
    "effort",
    "risk",
    "dependencies",
    "acceptanceCriteria",
    "allowedPaths",
    "approvedProtectedPaths",
    "requiredChecks",
    "approval",
    "lease",
    "transitions"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "ready", "in-progress", "done", "blocked", "rejected"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "claim", "url", "publisher", "retrievedAt", "version"],
        "properties": {
          "classification": { "type": "string", "enum": ["verified", "inference", "unknown"] },
          "claim": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"] },
          "publisher": { "type": ["string", "null"] },
          "retrievedAt": { "type": ["string", "null"] },
          "version": { "type": ["string", "null"] }
        }
      }
    },
    "expectedBenefit": { "type": "string", "minLength": 1 },
    "effort": { "type": "string", "enum": ["S", "M", "L"] },
    "risk": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "verification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 1 }
        }
      }
    },
    "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "approvedProtectedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requiredChecks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "approval": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["actor", "approvedAt", "payloadSha256"],
      "properties": {
        "actor": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "minLength": 1 },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "lease": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "owner", "runId", "acquiredAt", "expiresAt", "attempt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "runId": { "type": "string", "minLength": 1 },
        "acquiredAt": { "type": "string", "minLength": 1 },
        "expiresAt": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "actor", "role", "at", "reason"],
        "properties": {
          "from": { "type": ["string", "null"] },
          "to": { "type": "string" },
          "actor": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["learning-agent", "improvement-agent", "maintainer", "ci"] },
          "at": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}