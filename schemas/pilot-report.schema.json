{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/pilot-report.schema.json",
  "title": "Continuous Improvement Pilot Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "period",
    "proposalCycles",
    "proposals",
    "improvements",
    "usage",
    "meanEvaluationDelta",
    "limitations",
    "evidence",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "endedAt"],
      "properties": {
        "startedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "proposalCycles": { "type": "integer", "minimum": 0 },
    "proposals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "accepted", "duplicates"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "accepted": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 }
      }
    },
    "improvements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "completed", "independentlyReviewed"],
      "properties": {
        "attempted": { "type": "integer", "minimum": 0 },
        "completed": { "type": "integer", "minimum": 0 },
        "independentlyReviewed": { "type": "integer", "minimum": 0 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalAiCredits", "totalMaintainerMinutes"],
      "properties": {
        "totalAiCredits": { "type": "number", "minimum": 0 },
        "totalMaintainerMinutes": { "type": "number", "minimum": 0 }
      }
    },
    "meanEvaluationDelta": { "type": "number" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "reference"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["proposal-cycle", "pull-request", "evaluation", "billing", "maintainer-review"]
          },
          "reference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation", "approvedBy", "approvedAt"],
      "properties": {
        "recommendation": { "type": "string", "enum": ["graduate", "revise", "stop"] },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
