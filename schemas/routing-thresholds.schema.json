{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cody-Sims/agent-skills/schemas/routing-thresholds.schema.json",
  "title": "Measured Agent Skill Routing Threshold Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteSha256", "sourceResultSha256", "measuredAt", "trials", "adapter", "measured", "thresholds"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "suiteSha256": { "$ref": "#/$defs/hash" },
    "sourceResultSha256": { "$ref": "#/$defs/hash" },
    "measuredAt": { "$ref": "#/$defs/date" },
    "trials": { "type": "integer", "minimum": 1, "maximum": 100 },
    "adapter": { "$ref": "#/$defs/adapter" },
    "measured": { "$ref": "#/$defs/measured" },
    "thresholds": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "model"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "measured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationRecall", "overallPrecision", "overallCollisionRate"],
      "properties": {
        "validationRecall": { "$ref": "#/$defs/rate" },
        "overallPrecision": { "$ref": "#/$defs/rate" },
        "overallCollisionRate": { "$ref": "#/$defs/rate" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumValidationRecall", "minimumOverallPrecision", "maximumOverallCollisionRate"],
      "properties": {
        "minimumValidationRecall": { "$ref": "#/$defs/rate" },
        "minimumOverallPrecision": { "$ref": "#/$defs/rate" },
        "maximumOverallCollisionRate": { "$ref": "#/$defs/rate" }
      }
    }
  }
}
